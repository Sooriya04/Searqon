{
  "name": "searqon",
  "version": "1.0.0",
  "description": "Searqon is a microservice-based web search and extraction engine designed as an open alternative to Tavily.",
  "keywords": [
    ""
  ],
  "homepage": "https://github.com/Sooriya04/Searqon#readme",
  "bugs": {
    "url": "https://github.com/Sooriya04/Searqon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sooriya04/Searqon.git"
  },
  "license": "MIT",
  "author": "Sooriya",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:go": "cd go_scraper && go build -o ../go_scraper_bin main.go",
    "start": "npm run build:go && npx concurrently \"node server.js\" \"./go_scraper_bin\"",
    "dev": "npx concurrently \"npx nodemon server.js\" \"cd go_scraper && go run main.go\"",
    "db": "node database/server.js",
    "db:dev": "npx nodemon database/server.js"
  },
  "dependencies": {
    "axios": "^1.13.3",
    "better-sqlite3": "^12.8.0",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "js-yaml": "^4.1.1",
    "winston": "^3.19.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11"
  }
}
