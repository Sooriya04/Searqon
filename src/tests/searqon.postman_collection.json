{
  "info": {
    "name": "Searqon API Test Suite",
    "_postman_id": "searqon-collection-v1",
    "description": "Black-box E2E API collection for Searqon Web Intelligence Engine",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Status is ok and endpoints listed', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.status).to.eql('ok');",
              "    pm.expect(jsonData.data.endpoints.length).to.be.above(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "OpenAPI Specification",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/openapi.json",
          "host": ["{{baseUrl}}"],
          "path": ["openapi.json"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response is valid OpenAPI 3.0 schema', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.openapi).to.exist;",
              "    pm.expect(jsonData.paths).to.exist;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Prometheus Metrics",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/metrics",
          "host": ["{{baseUrl}}"],
          "path": ["metrics"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Contains Prometheus metrics metrics text', function () {",
              "    var text = pm.response.text();",
              "    pm.expect(text).to.include('searqon_requests_total');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Web Scraper (Markdown)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://example.com\",\n  \"format\": \"markdown\",\n  \"bypass_cache\": true,\n  \"stealth_level\": \"auto\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/scrape",
          "host": ["{{baseUrl}}"],
          "path": ["scrape"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Extracted markdown and title exist', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.markdown.length).to.be.above(0);",
              "    pm.expect(jsonData.data.title).to.exist;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Meta Search",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"open source software\",\n  \"limit\": 3,\n  \"bypass_cache\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/search",
          "host": ["{{baseUrl}}"],
          "path": ["search"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Search returns results array', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.results).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Site Map Explorer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://example.com\",\n  \"limit\": 5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/map",
          "host": ["{{baseUrl}}"],
          "path": ["map"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Links are mapped successfully', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.sourceUrl).to.exist;",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
