    },
    {
      "name": "Web Scraper (Markdown)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://example.com\",\n  \"format\": \"markdown\",\n  \"bypass_cache\": false,\n  \"stealth_level\": \"auto\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/scrape",
          "host": ["{{baseUrl}}"],
          "path": ["scrape"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Extracted markdown and title exist', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.markdown.length).to.be.above(0);",
              "    pm.expect(jsonData.data.title).to.exist;",
              "});"
            ]
          }
        }
      ]
    },
